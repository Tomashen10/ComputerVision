from collections import Counter
import torch

# Compute class weights based on the dataset
def compute_class_weights(dataset, indices):
    """
    Compute weights for each class based on their frequency in the dataset.
    Args:
        dataset: The dataset object.
        indices: The indices for the subset (train or validation).
    Returns:
        A tensor containing weights for each class.
    """
    targets = [dataset.dataset.targets[i] for i in indices]  # Get targets for the subset
    class_counts = Counter(targets)  # Count occurrences of each class
    total_samples = len(targets)  # Total samples in the subset

    # Compute weight for each class as total_samples / (number of classes * class_count)
    class_weights = {
        cls: total_samples / (len(class_counts) * count)
        for cls, count in class_counts.items()
    }
    return torch.tensor([class_weights[i] for i in range(len(class_counts))], dtype=torch.float32)

