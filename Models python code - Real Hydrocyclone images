def train_model_stratified_kfold_with_two_phases(
    full_dataset, train_transform, val_transform, num_epochs_phase1=5, num_epochs_phase2=50, patience=5, k_folds=5
):
    subset_indices = full_dataset.indices
    subset_targets = [full_dataset.dataset.targets[i] for i in subset_indices]
    class_names = full_dataset.dataset.classes

    skf = StratifiedKFold(n_splits=k_folds, shuffle=True, random_state=42)
    results = {}
    metrics_per_fold = []
    models_per_fold = []
    train_eval_metrics_per_fold = []

    for fold, (train_ids, val_ids) in enumerate(skf.split(np.zeros(len(full_dataset)), subset_targets)):
        print(f'FOLD {fold}')
        print('-' * 10)

        # Initialize the model
        model = torchvision.models.resnet18(weights='IMAGENET1K_V1')
        num_ftrs = model.fc.in_features
        model.fc = nn.Linear(num_ftrs, len(class_names))
        model = model.to(device)

        # Create samplers and dataloaders
        train_sampler = SubsetRandomSampler(train_ids)
        val_sampler = SubsetRandomSampler(val_ids)
        train_dataset = ImageFolder(root=full_dataset.dataset.root, transform=train_transform)
        val_dataset = ImageFolder(root=full_dataset.dataset.root, transform=val_transform)
        train_loader = DataLoader(train_dataset, sampler=train_sampler, batch_size=32)
        val_loader = DataLoader(val_dataset, sampler=val_sampler, batch_size=32)
        dataloaders = {'train': train_loader, 'val': val_loader}
        dataset_sizes = {'train': len(train_ids), 'val': len(val_ids)}

        # Compute class weights
        class_weights = compute_class_weights(full_dataset, train_ids).to(device)
        criterion = nn.CrossEntropyLoss(weight=class_weights)

        # Save the initial model state
        initial_model_path = f'initial_model_state_fold_{fold}_2phaseTraining.pt'
        torch.save(model.state_dict(), initial_model_path)

        # Reset the model to its initial state for each fold
        model.load_state_dict(torch.load(f'initial_model_state_fold_{fold}_2phaseTraining.pt'))

        ## Phase 1: Train only the classification layer
        for param in model.parameters():
            param.requires_grad = False
        for param in model.fc.parameters():
            param.requires_grad = True

        optimizer = optim.SGD(model.fc.parameters(), lr=0.01, momentum=0.9)
        scheduler = CyclicLR(optimizer, base_lr=1e-3, max_lr=0.03, step_size_up=136, mode='triangular')

        print(f"Training Phase 1: Only classification layer")
        train_and_validate(
            model, dataloaders, dataset_sizes, criterion, optimizer, scheduler, num_epochs_phase1, patience, fold, device, train_phase=1
        )

        ## Phase 2: Fine-tune the entire model
        for param in model.parameters():
            param.requires_grad = True

        optimizer = optim.SGD(model.parameters(), lr=0.001, momentum=0.9)
        scheduler = CyclicLR(optimizer, base_lr=0.0001, max_lr=0.002, step_size_up=136, mode='triangular')



        print(f"Training Phase 2: Fine-tuning entire model")
        train_and_validate(
            model, dataloaders, dataset_sizes, criterion, optimizer, scheduler, num_epochs_phase2, patience, fold, device, train_phase=2
        )

        # Save and evaluate the model
        best_model_path = f'best_model_params_phase_2_fold_{fold}.pt'
        model.load_state_dict(torch.load(best_model_path))
        fold_metrics = evaluate_model_metrics(model, val_loader, device)
        metrics_per_fold.append({
            'fold': fold,
            'accuracy': fold_metrics['accuracy'],
            'precision': fold_metrics['precision'],
            'recall': fold_metrics['recall'],
            'f1': fold_metrics['f1']
        })
        models_per_fold.append(copy.deepcopy(model))

    return results, metrics_per_fold, models_per_fold


def train_and_validate(
    model, dataloaders, dataset_sizes, criterion, optimizer, scheduler, num_epochs, patience, fold, device, train_phase
):
    best_loss = float('inf')
    epochs_no_improve = 0
    best_model_path = f'best_model_params_phase_{train_phase}_fold_{fold}.pt'
    train_losses=[]
    train_acc = []
    train_f1 = []
    eval_losses = []
    eval_acc = []
    eval_f1 = []
    best_f1 = 0.0
    best_acc = 0.0

    for epoch in range(num_epochs):
        print(f'Epoch {epoch}/{num_epochs - 1} (Phase {train_phase})')
        print('-' * 10)

        for phase in ['train', 'val']:
            if phase == 'train':
                model.train()
            else:
                model.eval()

            running_loss = 0.0
            running_corrects = 0
            all_preds = []  
            all_labels = []  

            for inputs, labels in dataloaders[phase]:
                inputs, labels = inputs.to(device), labels.to(device)
                optimizer.zero_grad()

                with torch.set_grad_enabled(phase == 'train'):
                    outputs = model(inputs)
                    _, preds = torch.max(outputs, 1)
                    loss = criterion(outputs, labels)

                    if phase == 'train':
                        loss.backward()
                        optimizer.step()
                        scheduler.step()

                #Statistics
                running_loss += loss.item() * inputs.size(0)
                running_corrects += torch.sum(preds == labels.data)

                # Collect all predictions and true labels for F1 score calculation
                all_preds.extend(preds.cpu().numpy())
                all_labels.extend(labels.cpu().numpy())

            epoch_loss = running_loss / dataset_sizes[phase]
            epoch_acc = running_corrects.double() / dataset_sizes[phase]
            # Calculate F1 score using sklearn's f1_score function
            epoch_f1 = f1_score(all_labels, all_preds, average='macro')

            if phase == 'train':
                train_losses.append(epoch_loss)
                train_acc.append(epoch_acc)
                train_f1.append(epoch_f1)
                 # log the current learning rate
                for param_group in optimizer.param_groups:
                    current_lr = param_group['lr']
                print(f'Current Learning Rate: {current_lr:.6f}')  # Print the learning rate

            else:
                eval_losses.append(epoch_loss)
                eval_acc.append(epoch_acc)
                eval_f1.append(epoch_f1)
                

            print(f'{phase} Loss: {epoch_loss:.4f} Acc: {epoch_acc:.4f} F1: {epoch_f1:.4f}')

            if phase == 'val':
                if epoch_loss < best_loss:
                    # Both metrics improved
                    best_loss = epoch_loss
                    best_f1 = epoch_f1
                    best_acc = epoch_acc
                    torch.save(model.state_dict(), best_model_path)
                    print(f"New best model saved at epoch {epoch+1}.")
                    epochs_no_improve = 0
                else:
                    # No improvement in both metrics
                    epochs_no_improve += 1
                    print(f"No improvement in validation metrics. Patience counter: {epochs_no_improve}/{patience}")

        if epochs_no_improve > patience:
            print(f"Early stopping in Phase {train_phase}.")
            break
