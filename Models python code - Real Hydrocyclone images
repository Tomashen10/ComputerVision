import numpy as np

def compute_metrics(pred):
    # Check the shape of predictions and labels
    print(f"Predictions shape: {np.array(pred.predictions).shape}")
    print(f"Labels shape: {np.array(pred.label_ids).shape}")

    # Ensure predictions are a NumPy array and take argmax if multi-class
    if len(np.array(pred.predictions).shape) > 1:
        preds = np.argmax(np.array(pred.predictions), axis=-1)
    else:
        preds = np.array(pred.predictions)

    labels = np.array(pred.label_ids)

    # Compute metrics
    accuracy = accuracy_score(labels, preds)
    precision, recall, f1, _ = precision_recall_fscore_support(labels, preds, average='macro')

    return {
        'accuracy': accuracy,
        'precision': precision,
        'recall': recall,
        'f1': f1
    }

